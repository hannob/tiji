#!/usr/bin/env python3

import argparse
import datetime
import os
import pathlib
import shutil

import html5lib
import jinja2

ap = argparse.ArgumentParser()
ap.add_argument("pagedir")
ap.add_argument("-o", "--out", default="out")
args = ap.parse_args()

htmlparser = html5lib.HTMLParser(strict=True)

e = jinja2.Environment(loader=jinja2.FileSystemLoader(f"{args.pagedir}/templates"), autoescape=True)

if os.path.exists("out"):
    now = datetime.datetime.now(datetime.UTC).isoformat()
    os.rename("out", f"out-{now}.bak")

shutil.copytree(f"{args.pagedir}/static", "out")

for root, _, files in os.walk(f"{args.pagedir}/templates/"):
    outdir = os.path.join(args.out, root.split(f"{args.pagedir}/templates/")[1])
    if not os.path.isdir(outdir):
        os.mkdir(outdir)

    for fn in files:
        if not fn.endswith(".html"):
            continue
        fp = os.path.join(root, fn)
        fp = fp.split(f"{args.pagedir}/templates/")[1]

        template = e.get_template(fp)
        html = template.render()

        # parse with html5lib to avoid basic HTML mistakes,
        # but skip files starting with _ (used for fragments)
        if not fn.startswith("_"):
            try:
                htmlparser.parse(html)
            except html5lib.html5parser.ParseError as err:
                print(f"HTML Error with {fp}")
                print(err)
                print(htmlparser.errors)

        pathlib.Path(os.path.join(outdir, fn)).write_text(html)
